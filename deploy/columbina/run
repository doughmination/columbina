#!/bin/sh
# runit service for Columbina.
# Adjust these to match where the bot lives on the server.
SANDRONE_DIR=/srv/clove/columbina
SANDRONE_USER=clove

exec 2>&1

cd "$SANDRONE_DIR" || exit 1

export HOME="$(getent passwd "$SANDRONE_USER" | cut -d: -f6)"
export PATH=/usr/local/bin:/usr/bin:/bin
export PYTHONUNBUFFERED=1

exec chpst -u "$SANDRONE_USER" uv run --frozen --no-dev python -m columbina
